<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <style>
    body { font-family: Arial, sans-serif; background: #fff3f6; padding: 20px; }
    .card {
      background: white;
      border-radius: 12px;
      padding: 24px;
      max-width: 500px;
      margin: auto;
      text-align: center;
    }
    img {
      width: 90px;
      height: 90px;
      border-radius: 50%;
      margin-bottom: 12px;
    }
    h2 { color: #ff5b77; }
    .btn {
      display: inline-block;
      padding: 12px 24px;
      background: #ff5b77;
      color: white;
      border-radius: 8px;
      text-decoration: none;
      margin-top: 16px;
    }
  </style>
</head>
<body>
  <div class="card">
    <img src="<%= profilePic %>" />
    <h2>New Message Received 💌</h2>

    <p>
      <strong><%= senderName %></strong>
      (ID: <%= senderId %>) sent you a message.
    </p>

    <a href="https://www.vedvivah.com/chat" class="btn">
      Open VedVivah Chat
    </a>

    <p style="margin-top:20px;font-size:13px;color:#777">
      🪔 VedVivah Team
    </p>
  </div>
</body>
</html>

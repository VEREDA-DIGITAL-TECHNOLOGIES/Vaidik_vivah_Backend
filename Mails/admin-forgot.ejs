<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Ved Vivah Admin Password Reset</title>
</head>

<body style="
  margin:0;
  padding:0;
  background-color:#fff5f7;
  font-family: Arial, Helvetica, sans-serif;
">

  <!-- OUTER WRAPPER -->
  <table width="100%" cellpadding="0" cellspacing="0" role="presentation">
    <tr>
      <td align="center" style="padding:20px;">

        <!-- MAIN CARD -->
        <table width="100%" cellpadding="0" cellspacing="0" role="presentation"
          style="
            max-width:600px;
            background:#ffffff;
            border-radius:16px;
            border:1px solid #ffebee;
            overflow:hidden;
          ">

          <!-- TOP BAR -->
          <tr>
            <td style="height:8px;background:#e91e63;"></td>
          </tr>

          <!-- LOGO -->
          <tr>
            <td align="center" style="padding:24px 20px 10px;">
              <a href="https://www.vedvivah.com" target="_blank">
                <img
                  src="https://vedvivah.com/assets/v.png"
                  alt="Ved Vivah Logo"
                  width="220"
                  style="max-width:100%;height:auto;display:block;"
                />
              </a>
            </td>
          </tr>

          <!-- SUB TITLE -->
          <tr>
            <td align="center" style="padding:6px 20px;">
              <p style="
                margin:0;
                font-size:14px;
                color:#5e5e5e;
              ">
                Reset Your <strong style="color:#d81b60;">Ved Vivah Admin Password</strong>
              </p>
            </td>
          </tr>

          <!-- MAIN HEADING -->
          <tr>
            <td align="center" style="padding:10px 20px 20px;">
              <h2 style="
                margin:0;
                font-size:26px;
                color:#d81b60;
                font-weight:bold;
              ">
                Password Reset OTP
              </h2>
            </td>
          </tr>

          <!-- CONTENT -->
          <tr>
            <td style="
              padding:0 24px;
              color:#5e5e5e;
              font-size:15px;
              line-height:22px;
            ">
              <p>Dear Admin,</p>

              <p>
                We received a request to reset your Ved Vivah Admin password.
                Use the One-Time Password (OTP) below to complete your password reset:
              </p>
            </td>
          </tr>

          <!-- OTP BLOCK -->
          <tr>
            <td align="center" style="padding:24px;">
              <table cellpadding="0" cellspacing="0" role="presentation">
                <tr>
                  <% activationCode.split('').forEach((char) => { %>
                    <td
                      style="
                        background:#e91e63;
                        color:#ffffff;
                        font-size:22px;
                        font-weight:bold;
                        padding:14px 18px;
                        border-radius:10px;
                        text-align:center;
                        min-width:42px;
                      ">
                      <%= char %>
                    </td>
                    <td width="8"></td>
                  <% }) %>
                </tr>
              </table>
            </td>
          </tr>

          <!-- SECURITY NOTE -->
          <tr>
            <td style="
              padding:0 24px 10px;
              color:#5e5e5e;
              font-size:14px;
              line-height:20px;
            ">
              <p>
                This OTP is valid for <strong>5 minutes</strong>.
                For security reasons, do not share it with anyone.
                If you did not request a password reset, you can safely ignore this email —
                your password will remain unchanged.
              </p>
            </td>
          </tr>

          <!-- SIGNATURE -->
          <tr>
            <td style="
              padding:0 24px 24px;
              color:#d81b60;
              font-weight:bold;
              font-size:14px;
            ">
              With ♥,<br/>
              The Ved Vivah Admin Team
            </td>
          </tr>

          <!-- FOOTER -->
          <tr>
            <td align="center" style="
              padding:16px;
              border-top:1px solid #ffebee;
              font-size:12px;
              color:#888;
            ">
              © 2025 Ved Vivah Admin Portal. All rights reserved.<br/><br/>
              <a href="https://admin.vedvivah.com"
                 style="color:#d81b60;text-decoration:none;font-weight:bold;">
                https://admin.vedvivah.com
              </a><br/><br/>
              Need help?
              <a href="mailto:support@vedvivah.com"
                 style="color:#d81b60;text-decoration:none;">
                Contact our support team
              </a>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>

</body>
</html>

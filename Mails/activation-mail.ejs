<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vaidikvivah Account Activation</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f9f0f3;
        }

        .container {
            width: 100%;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .main {
            max-width: 600px;
            background: #fff;
            padding: 2rem;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        }

        .logo {
            text-align: center;
            margin-bottom: 1.5rem;
        }

        .logo img {
            max-width: 180px;
        }

        h2 {
            font-size: 18px;
            font-weight: normal;
            color: #4D4D4D;
        }

        h3 {
            color: #000;
            font-size: 24px;
            margin: 1.5rem 0 0.5rem;
        }

        .highlight {
            color: #FD5C90;
            font-weight: bold;
        }

        .otp {
            display: flex;
            justify-content: center;
            gap: 16px;
            margin: 1.5rem 0;
        }

        .otp div {
            font-size: 32px;
            font-weight: bold;
            color: #FD5C90;
            border: 2px solid #FD5C90;
            border-radius: 10px;
            padding: 10px 20px;
            min-width: 50px;
            text-align: center;
        }

        .countdown {
            text-align: center;
            color: #FD5C90;
            font-weight: bold;
            margin-bottom: 1rem;
        }

        .warning {
            background: #ffeaf0;
            padding: 1rem;
            border-radius: 10px;
            font-size: 14px;
            color: #4D4D4D;
        }

        .footer {
            text-align: center;
            margin-top: 2rem;
            font-size: 14px;
            color: #666;
        }

        a {
            color: #4D4D4D;
            text-decoration: none;
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="main">
            <div class="logo">
                <a href="https://www.vaidikvivah.in">
                    <img src="https://vaidikvivah.in/vaidikvivah-img.jpg" alt="VaidikVivah Logo" />
                </a>
            </div>
            <h2>Welcome To <span class="highlight">vaidikvivah</span></h2>
            <h3>Confirmation code</h3>
            <p>Verify your new <span class="highlight">vaidikvivah</span> account</p>
            <p>To verify your email address, please use the following OTP</p>

            <div class="otp">
                <% activationCode.split('').forEach((char)=> { %>
                    <div>
                        <%= char %>
                    </div>
                    <% }) %>
            </div>

            <div class="countdown">00:30</div>

            <div class="warning">
                ⚠️ Do not share this OTP with anyone. Vaidikvivah takes your account security very seriously.
                Vaidikvivah will never ask you to disclose or verify your Vaidikvivah password, OTP, credit card, or
                banking account number. If you receive a suspicious email with a link to update your account
                information, do not click on the link – instead, report the email to Vaidikvivah for investigation.
            </div>

            <div class="footer">
                <p>The VaidikVivah Team</p>
                <p><a href="https://www.vaidikvivah.in">https://www.vaidikvivah.in</a></p>
                <p>Copyright © 2025 Vaidikvivah</p>
            </div>
        </div>
    </div>
</body>

</html>






